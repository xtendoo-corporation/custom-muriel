<odoo>
    <record id="contract_contract_form_view_route_id_form" model="ir.ui.view">
        <field name="name">contract.contract.route.id.form</field>
        <field name="model">contract.contract</field>
        <field name="inherit_id" ref="contract.contract_contract_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='sale_autoconfirm']" position="after">
                <field name="route_id"/>
            </xpath>
        </field>
    </record>
</odoo>
