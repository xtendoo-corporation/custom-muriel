<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_tree_inherited" model="ir.ui.view">
        <field name="name">stock.move.tree.inherited</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_move_tree"/>
        <field name="arch" type="xml">
            <field name="reference" position="after">
                <field name="partner_id" string="Contacto" optional="show"/>
            </field>
        </field>
    </record>

     <record id="view_move_search_inherited" model="ir.ui.view">
        <field name="name">stock.move.search.inherited</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_move_search"/>
        <field name="arch" type="xml">
            <filter name="groupby_picking_id" position="after">
                <filter string="Contacto" name="groupby_partner" domain="[]" context="{'group_by': 'partner_id'}"/>
            </filter>
        </field>
    </record>
</odoo>
