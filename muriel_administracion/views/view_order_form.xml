<odoo>
    <record id="view_order_form_mobile_hide_fields" model="ir.ui.view">
        <field name="name">sale.order.form.mobile.hide.fields</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_invoice_id']" position="attributes">
                <attribute name="class">o_mobile_hide</attribute>
            </xpath>
            <xpath expr="//field[@name='partner_shipping_id']" position="attributes">
                <attribute name="class">o_mobile_hide</attribute>
            </xpath>
            <xpath expr="//field[@name='date_order' and @groups='base.group_no_one']" position="attributes">
                <attribute name="class">o_mobile_hide</attribute>
            </xpath>
            <xpath expr="(//field[@name='date_order'])[2]" position="attributes">
                <attribute name="class">o_mobile_hide</attribute>
            </xpath>
            <xpath expr="//field[@name='pricelist_id']" position="attributes">
                <attribute name="class">o_mobile_hide</attribute>
            </xpath>
            <xpath expr="//field[@name='payment_term_id']" position="attributes">
                <attribute name="class">o_mobile_hide</attribute>
            </xpath>
            <xpath expr="//field[@name='route_id']" position="attributes">
                <attribute name="class">o_mobile_hide</attribute>
            </xpath>
            <xpath expr="//kanban[@class='o_kanban_mobile']/templates/t[@t-name='card']" position="replace">
                 <t t-name="card">
                    <div class="row align-items-center" style="cursor:default;">
                        <div class="col-4">
                            <field name="product_id" options="{'no_open': True}"/>
                        </div>
                        <div class="col-2">
                            <field name="product_uom_qty" readonly="0"/>
                        </div>
                        <div class="col-2">
                            <field name="product_uom"/>
                        </div>
                        <div class="col-2">
                            <field name="price_unit" readonly="0"/>
                        </div>
                        <div class="col-2">
                            <field name="price_subtotal" widget="monetary"/>
                        </div>
                    </div>
                </t>
            </xpath>
             <xpath expr="//field[@name='order_line']" position="attributes">
                <attribute name="widget">sol_o2m</attribute>
                <attribute name="mode">list</attribute>
            </xpath>
        </field>
    </record>
</odoo>
