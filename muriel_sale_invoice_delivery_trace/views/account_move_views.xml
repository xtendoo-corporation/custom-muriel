<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_sale_trace" model="ir.ui.view">
        <field name="name">account.move.form.inherit.sale.trace</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_related_sales"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-shopping-cart"
                        invisible="related_sale_count == 0">
                    <field name="related_sale_count" widget="statinfo" string="Pedidos"/>
                </button>
            </div>
        </field>
    </record>
</odoo>

