<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista del Wizard -->
    <record id="view_invoice_sale_delivery_trace_wizard_form" model="ir.ui.view">
        <field name="name">invoice.sale.delivery.trace.wizard.form</field>
        <field name="model">invoice.sale.delivery.trace.wizard</field>
        <field name="arch" type="xml">
            <form string="Trazabilidad Facturas-Ventas-Entregas">
                <group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                </group>
                <footer>
                    <button name="action_generate_trace" string="Ver Trazabilidad" type="object" class="btn-primary"/>
                    <button name="action_export_excel" string="Exportar Excel" type="object" class="btn-secondary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>



    <!-- Acción para mostrar resultados -->
    <record id="action_invoice_sale_delivery_trace_results" model="ir.actions.act_window">
        <field name="name">Resultados Trazabilidad</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_invoice_sale_delivery_trace_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_invoice_sale_delivery_trace_form')})]"/>
        <field name="search_view_id" ref="view_invoice_sale_delivery_trace_search"/>
        <field name="target">current</field>
    </record>
</odoo>
