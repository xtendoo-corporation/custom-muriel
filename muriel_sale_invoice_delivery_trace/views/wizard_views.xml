<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_invoice_sale_delivery_trace_wizard_form" model="ir.ui.view">
        <field name="name">invoice.sale.delivery.trace.wizard.form</field>
        <field name="model">invoice.sale.delivery.trace.wizard</field>
        <field name="arch" type="xml">
            <form string="Trazabilidad Facturas-Ventas-Entregas">
                <group>
                    <group>
                        <field name="date_from" required="1"/>
                        <field name="date_to" required="1"/>
                    </group>
                    <group>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                </group>
                <footer>
                    <button name="action_generate_trace"
                            string="Ver Resultados"
                            type="object"
                            class="btn-primary"/>
                    <button name="action_export_excel"
                            string="Exportar a Excel"
                            type="object"
                            class="btn-secondary"/>
                    <button string="Cancelar"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>

