<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista de árbol -->
    <record id="view_invoice_sale_delivery_trace_tree" model="ir.ui.view">
        <field name="name">account.move.trace.list</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <list string="Trazabilidad Facturas-Ventas-Entregas">
                <field name="name" string="Factura"/>
                <field name="invoice_date"/>
                <field name="partner_id"/>
                <field name="invoice_origin"/>
                <field name="amount_total_signed"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- Vista de formulario -->
    <record id="view_invoice_sale_delivery_trace_form" model="ir.ui.view">
        <field name="name">account.move.trace.form</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <form string="Trazabilidad Facturas-Ventas-Entregas">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="invoice_date"/>
                            <field name="partner_id"/>
                        </group>
                        <group>
                            <field name="invoice_origin"/>
                            <field name="amount_total_signed"/>
                            <field name="state"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Líneas de Factura">
                            <field name="invoice_line_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="price_unit"/>
                                    <field name="price_subtotal"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vista de búsqueda -->
    <record id="view_invoice_sale_delivery_trace_search" model="ir.ui.view">
        <field name="name">account.move.trace.search</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <search string="Buscar Facturas">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="invoice_date"/>
                <field name="invoice_origin"/>
                <filter name="filter_draft" string="Borrador" domain="[('state','=','draft')]"/>
                <filter name="filter_posted" string="Publicado" domain="[('state','=','posted')]"/>
            </search>
        </field>
    </record>
</odoo>
