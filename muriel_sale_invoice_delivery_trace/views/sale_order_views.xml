<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_delivery_trace" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.delivery.trace</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Entregas y Devoluciones" invisible="picking_count == 0">
                    <field name="related_picking_ids" readonly="1">
                        <list>
                            <field name="name"/>
                            <field name="picking_type_label"/>
                            <field name="scheduled_date"/>
                            <field name="state"/>
                            <field name="origin"/>
                            <field name="partner_id"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>

